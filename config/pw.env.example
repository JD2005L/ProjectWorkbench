# Project Workbench — authoritative non-secret environment contract.
#
# Generated by scripts/pw-env-write. Edit freely: the installer never overwrites an existing file.
# Consumed by the dashboard, both terminal units, the tmux persistence units and the dedicated
# tmux owner via EnvironmentFile=, and by the container-mode app/sidecar via --env-file.
#
# NOTHING SECRET BELONGS IN THIS FILE. Paths, the deploy mode, and feature flags only.

# which terminal model this instance runs (see app/deploy-mode.js)
PW_DEPLOY_MODE=host

# dashboard app directory; holds project-terminal-credentials.mjs, the fail-closed credential helper
PW_APP_DIR=/opt/project-workbench/app

# the project registry every entry point must agree on
PW_REGISTRY_PATH=/opt/project-workbench/projects.json

# the registry that means "this instance is NOT isolated" (see app/isolation.js)
PW_CANONICAL_REGISTRY=/opt/project-workbench/projects.json

# the users store credential ownership resolves against
PW_USERS_PATH=/etc/project-workbench/users.json

# dashboard login sessions
PW_SESSIONS_PATH=/var/lib/project-workbench/sessions.json

# project workspace root
PW_WORKSPACES=/opt/project-workbench/workspaces

# append-only audit log
PW_AUDIT_LOG=/var/log/project-workbench/audit.log

# per-user CLI credentials on/off — an absent value reads as "off", which is why the restore entrypoint must be told explicitly
PW_PER_USER_CLAUDE=false

# root of the per-user credential tree, owned by the pane account
PW_USER_CRED_BASE=/home/admin/pw-users

# tmux persistence manifest + captured scrollback
PW_TMUX_STATE_DIR=/var/lib/project-workbench/tmux-persist

# refuse to create a terminal unless the dedicated tmux owner is proven live (host mode only)
PW_TMUX_OWNER_REQUIRED=true
