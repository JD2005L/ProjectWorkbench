[Unit]
Description=Project Workbench: hibernate idle Claude Code sessions (windows and resume ids are kept)
After=pw-tmux-server.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/project-workbench/pw.env
User=@PW_USER@
Group=@PW_GROUP@
Environment=HOME=@PW_HOME@
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Nice=10
TimeoutStartSec=15min
ExecStart=/usr/local/bin/pw-claude-hibernate --apply
