[Unit]
# Fail CLOSED on the tmux owner: with Wants= a terminal starts anyway and
# creates the shared server itself, in its own cgroup — the exact topology the
# owner unit exists to prevent.
Requires=pw-tmux-server.service
After=pw-tmux-server.service
Description=Project Workbench: restore tmux sessions on boot, snapshot on stop
# Restore must finish before the per-project ttyd terminals attach, so that
# `tmux new-session -A` in project-terminal-start attaches to a restored session
# instead of creating an empty one. project-terminal@.service orders itself
# After= this unit.
After=network-online.target
Wants=network-online.target

[Service]
# The one non-secret environment contract (app/env-schema.js), so the dashboard,
# terminal creation and restore cannot disagree about where this instance keeps
# its state. `-` prefix: absent is not fatal, because every entry has a
# documented default — a MISCONFIGURED entry is what must fail, and the consumer
# is what detects that.
EnvironmentFile=-/etc/project-workbench/pw.env
Type=oneshot
RemainAfterExit=yes
# Never let stopping/restarting this unit tear down the shared tmux server.
KillMode=none
User=@PW_USER@
Group=@PW_GROUP@
Environment=HOME=@PW_HOME@
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
ExecStart=/usr/local/bin/pw-tmux-restore
ExecStop=/usr/local/bin/pw-tmux-save
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
