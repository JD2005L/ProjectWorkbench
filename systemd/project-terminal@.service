[Unit]
Description=ttyd terminal for project %i
After=network-online.target
Wants=network-online.target
# Attach to the shared tmux server that pw-tmux-server.service owns instead of racing to create it
# here. Whichever terminal won that race used to parent the server, putting every project's panes in
# one per-project ttyd unit's cgroup — see pw-tmux-server.service for the incident that caused.
#
# Wants= rather than Requires= on purpose: the fail-closed decision belongs to
# scripts/pw-tmux-assert-owner, which project-terminal-start calls before creating anything. It can
# tell "no owner yet" (exit 3) apart from "a foreign-owned server is already running" (exit 4) and
# report each with the action that fixes it; Requires= would only couple restarts and could not.
After=pw-tmux-server.service
Wants=pw-tmux-server.service
# Let tmux sessions be restored before this terminal attaches, so
# `tmux new-session -A` reattaches to the restored session instead of creating
# an empty one. Wants= (not Requires=) so a restore failure never blocks the
# terminal — it just comes up fresh, as it did before persistence existed.
After=pw-tmux-persist.service
Wants=pw-tmux-persist.service
[Service]
Type=simple
User=admin
Group=admin
Environment=HOME=/home/admin
# The authoritative non-secret environment contract (config/pw.env.example, app/pw-env.js).
# One file, read by the dashboard, both terminal units, the persistence units and the tmux owner, so
# no entrypoint can resolve a different registry/app dir/state dir/per-user flag than the others.
# `-` because a host that has not yet run the new installer must still start: the CONSUMERS enforce
# the contract (pw-tmux-restore exits EX_CONFIG on a misconfigured authoritative path), not systemd.
EnvironmentFile=-/etc/project-workbench/pw.env
ExecStart=/usr/local/bin/project-terminal-start %i
Restart=on-failure
RestartSec=3
# The shared tmux server has no unit of its own in host mode: whichever
# project-terminal@ instance runs `tmux new-session` first ends up parenting it,
# so EVERY project's pw_* panes live in that one instance's cgroup. Under the
# systemd defaults (OOMPolicy=stop, KillMode=control-group) a single OOM-killed
# pane failed the unit and took the whole cgroup — i.e. every project's sessions
# — down with it, mid-uptime, with no reboot to trigger pw-tmux-restore.
# (Observed 2026-08-03: `Failed with result 'oom-kill'`, 8.1G peak.)
#   OOMPolicy=continue — an OOM-killed pane no longer fails the unit.
#   KillMode=process   — stopping/restarting ttyd kills only ttyd, never the
#                        tmux server or the panes behind it.
OOMPolicy=continue
KillMode=process
[Install]
WantedBy=multi-user.target
