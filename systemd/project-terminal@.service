[Unit]
# Fail CLOSED on the tmux owner: with Wants= a terminal starts anyway and
# creates the shared server itself, in its own cgroup — the exact topology the
# owner unit exists to prevent.
Requires=pw-tmux-server.service
After=pw-tmux-server.service
Description=ttyd terminal for project %i
After=network-online.target
Wants=network-online.target
# Let tmux sessions be restored before this terminal attaches, so
# `tmux new-session -A` reattaches to the restored session instead of creating
# an empty one. Wants= (not Requires=) so a restore failure never blocks the
# terminal — it just comes up fresh, as it did before persistence existed.
After=pw-tmux-persist.service
Wants=pw-tmux-persist.service
[Service]
# The one non-secret environment contract (app/env-schema.js), so the dashboard,
# terminal creation and restore cannot disagree about where this instance keeps
# its state. `-` prefix: absent is not fatal, because every entry has a
# documented default — a MISCONFIGURED entry is what must fail, and the consumer
# is what detects that.
EnvironmentFile=-/etc/project-workbench/pw.env
Type=simple
User=admin
Group=admin
Environment=HOME=/home/admin
ExecStart=/usr/local/bin/project-terminal-start %i
Restart=on-failure
RestartSec=3
# The shared tmux server has no unit of its own in host mode: whichever
# project-terminal@ instance runs `tmux new-session` first ends up parenting it,
# so EVERY project's pw_* panes live in that one instance's cgroup. Under the
# systemd defaults (OOMPolicy=stop, KillMode=control-group) a single OOM-killed
# pane failed the unit and took the whole cgroup — i.e. every project's sessions
# — down with it, mid-uptime, with no reboot to trigger pw-tmux-restore.
# (Observed 2026-08-03: `Failed with result 'oom-kill'`, 8.1G peak.)
#   OOMPolicy=continue — an OOM-killed pane no longer fails the unit.
#   KillMode=process   — stopping/restarting ttyd kills only ttyd, never the
#                        tmux server or the panes behind it.
OOMPolicy=continue
KillMode=process
[Install]
WantedBy=multi-user.target
