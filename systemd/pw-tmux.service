[Unit]
Description=Project Workbench persistent tmux server (terminal sessions)
Documentation=https://github.com/GovAlta-EMU/ProjWB
After=network-online.target
Wants=network-online.target

# The main app container (project-workbench.service) is ordered After= and
# Requires= this unit so the shared tmux server is up before the app attaches.
[Service]
Type=simple
Restart=on-failure
RestartSec=5
Delegate=yes
Slice=pw-tmux.slice
ExecStartPre=-/usr/bin/podman rm -f pw-tmux
# Same image + same mounts as the app container so shells/agents in the panes see
# identical workspaces, agent homes, npm-global CLIs and CA trust. The extra
# -v .../run/tmux mount is the shared tmux socket dir; TMUX_TMPDIR points at it.
#
# --add-host TAKES DNS OUT OF THE MCP PATH. All four MCP servers in
# ~/.claude.json (teamkb, pulse, skillhub, visual-identity) are configured with
# this host's FQDN, and an MCP client gets ONE resolution attempt at session start
# and never retries — so a single transient negative DNS answer (NXDOMAIN,
# surfacing as `getaddrinfo ENOTFOUND`) silently disables ALL FOUR for that whole
# session. Observed 2026-09-08; the TeamKB project measured the trigger as a
# transient NXDOMAIN from a GOA resolver, not a local misconfiguration and not a
# TeamKB defect. nsswitch on the image is `hosts: files dns`, so a hosts entry
# wins and DNS is never consulted for this name.
#
# THE FQDN IS KEPT, not swapped for an address: the certificate's SAN is
# DNS:vnl2422.rm.gov.ab.ca only, so https://127.0.0.1/... fails verification
# (curl exit 60, measured), and dropping to http to dodge that would put the MCP
# bearer token and any revealed secret in cleartext even over loopback. "Just use
# the IP" is the obvious wrong simplification — it was the first suggestion made
# here, before anyone measured it.
#
# It must be a FLAG, not an edit: the container's /etc/hosts is a tmpfs bind from
# its own userdata, recreated on every restart, so a hand-added line evaporates
# exactly when the container is recreated.
#
# 127.0.0.1 rather than this host's routable address, deliberately: the container
# runs --network=host below, so loopback IS the host, and this avoids baking a
# site IP that renumbering would silently break. A sidecar that does NOT share the
# host network namespace must use its own reachable address instead, and a
# deployment with a different hostname must change the name.
ExecStart=/usr/bin/podman run --name pw-tmux \
  --network=host --pid=host --privileged --cgroupns=host --cgroup-parent=pw-tmux.slice \
  --add-host vnl2422.rm.gov.ab.ca:127.0.0.1 \
  -e TMUX_TMPDIR=/opt/project-workbench/run/tmux \
  -e PW_DEPLOY_MODE=container \
  -e PW_TMUX_OWNER_CGROUP=pw-tmux.slice \
  -e PW_TMUX_REQUIRE_CGROUP=1 \
  -e NPM_CONFIG_PREFIX=/opt/npm-global \
  -e PATH=/opt/npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
  -e "NODE_OPTIONS=--dns-result-order=ipv4first --no-network-family-autoselection" \
  -v /etc/server-docs:/etc/server-docs:ro \
  -v /opt/project-workbench/source/app:/opt/project-workbench/app \
  -v /opt/project-workbench/source/scripts:/opt/project-workbench/scripts \
  -v /opt/project-workbench/workspaces:/opt/project-workbench/workspaces \
  -v /opt/project-workbench/memory:/opt/project-workbench/memory \
  -v /etc/project-workbench:/etc/project-workbench \
  -v /etc/nginx/conf.d:/etc/nginx/conf.d \
  -v /opt/project-workbench/persistent/npm-global:/opt/npm-global \
  -v /opt/project-workbench/persistent/root-home:/root \
  -v /opt/project-workbench/persistent/admin-home:/home/admin \
  -v /opt/project-workbench/run/tmux:/opt/project-workbench/run/tmux \
  project-workbench:latest \
  /opt/project-workbench/scripts/pw-tmux-keepalive.sh
ExecStop=/usr/bin/podman stop -t 10 pw-tmux

[Install]
WantedBy=multi-user.target
