[Unit]
Description=Project Workbench persistent tmux server (terminal sessions)
Documentation=https://github.com/GovAlta-EMU/ProjWB
After=network-online.target
Wants=network-online.target

# The main app container (project-workbench.service) is ordered After= and
# Requires= this unit so the shared tmux server is up before the app attaches.
[Service]
Type=simple
Restart=on-failure
RestartSec=5
Delegate=yes
Slice=pw-tmux.slice
ExecStartPre=-/usr/bin/podman rm -f pw-tmux

# HOST ALIASES ARE CONFIGURATION, NOT CONTENT. This unit ships to every
# deployment, so it carries the MECHANISM and none of the values.
#
# The mechanism takes DNS out of the path for a name this instance must always
# resolve. An MCP client resolves each configured server ONCE at session start
# and never retries, so a single transient negative answer (NXDOMAIN, surfacing
# as `getaddrinfo ENOTFOUND`) silently disables every name-configured MCP server
# for that entire session. Observed 2026-09-08; the trigger measured there was a
# transient NXDOMAIN from a site resolver, not a local misconfiguration and not a
# defect in any MCP server. nsswitch on the image is `hosts: files dns`, so a
# hosts entry wins and DNS is never consulted for that name.
#
# It must be a FLAG, not an edit: the container's /etc/hosts is a tmpfs bind from
# its own userdata, recreated on every restart, so a hand-added line evaporates
# exactly when the container is recreated.
#
# THE DEFAULT IS NO OVERRIDE, and this expansion is UNBRACED on purpose: systemd
# splits an unbraced expansion at whitespace, so the empty default below
# contributes ZERO arguments. A braced ${...} would pass one empty argument
# instead, which podman rejects — "absent" would become "broken" for every
# deployment that does not configure this.
#
# A deployment that needs a mapping sets it in the environment file below or in a
# drop-in, as repetitions of `--add-host` with a <host>:<literal-address> value.
# It supplies the VALUE only; validating it is this unit's job, below. See
# deploy/host/files/etc/systemd/system/pw-tmux.service.d/host-alias.conf.example.
#
# THE ADDRESS MUST BE A LITERAL, and the checker refuses a name: a name would be
# resolved by the very resolver the mapping exists to bypass. Where the mapped
# service is reached over TLS the FQDN must also be kept in the URL rather than
# swapped for its address — a certificate whose SAN carries only the name fails
# verification against an address URL (curl exit 60, measured), and dropping to
# http to dodge that would put a bearer token in cleartext even over loopback.
# "Just use the IP in the URL" is the obvious wrong simplification.
#
# Order matters: systemd applies Environment= and EnvironmentFile= in the order
# they appear, so the empty default has to come FIRST for configuration to be
# able to override it.
Environment=PW_TMUX_HOST_ALIAS_ARGS=
EnvironmentFile=-/etc/project-workbench/pw.env

# The precondition for a LOOPBACK alias, declared where the checker can read it.
# 127.0.0.1 means "the host" only because the container shares the host network
# namespace below; without that, loopback is the container itself and the mapping
# silently points at nothing. A sidecar that does not share the host network must
# map its own reachable address instead, and pw-host-alias-check refuses a
# loopback alias whenever this does not say host. Keep the two in step: this
# claim and --network= are the same fact stated twice, and a test asserts they
# agree.
#
# Declared AFTER the environment file, deliberately, and unlike the aliases
# themselves: this is a property of the unit, not a setting, so configuration
# must not be able to claim host networking that this unit does not actually
# give the container — that would satisfy the precondition without making it
# true. A deployment that changes --network= edits the unit, and the test above
# holds it to changing both.
Environment=PW_TMUX_NETWORK_MODE=host

# THE GATE BELONGS TO THIS UNIT, NOT TO A DROP-IN — because the unit is what
# advertises the environment file above and expands the result into podman's
# argv. An earlier revision put the check in the optional drop-in that carried
# the value, so an operator who configured the documented pw.env path got no
# validation at all: fail-closed held only for the one route that happened to
# bring its own checker. Every supported way of setting the aliases now passes
# through here, and the empty default passes it unchanged.
#
# NO `-` PREFIX. A malformed mapping, or a loopback address on a sidecar that
# does not share the host network namespace, must FAIL this unit — not be ignored
# into a container whose clients then fail later, one at a time, for reasons
# nobody connects back to a config file. The checker exits 78 (EX_CONFIG), so
# `systemctl status` tells a misconfigured instance from a crashed check.
#
# AND IT RUNS FROM THE IMAGE THE ExecStart ALREADY REQUIRES. That is what makes a
# fatal ExecStartPre safe here. A non-`-` ExecStartPre naming a host path that is
# not present is 203/EXEC, which for THIS unit is every terminal on the host
# failing to start — and install.sh refuses to run beside this sidecar, so no
# host installer ships one. The Containerfile bakes scripts/ and app/ at these
# paths, so the gate cannot be missing while the command it guards can still run.
# Deliberately unprivileged and without --pid=host: validating a string needs
# neither, and the flags below must not be copied up here by habit.
ExecStartPre=/usr/bin/podman run --rm --network=none \
  -e PW_TMUX_HOST_ALIAS_ARGS -e PW_TMUX_NETWORK_MODE \
  project-workbench:latest \
  /opt/project-workbench/scripts/pw-host-alias-check

# Same image + same mounts as the app container so shells/agents in the panes see
# identical workspaces, agent homes, npm-global CLIs and CA trust. The extra
# -v .../run/tmux mount is the shared tmux socket dir; TMUX_TMPDIR points at it.
ExecStart=/usr/bin/podman run --name pw-tmux \
  --network=host --pid=host --privileged --cgroupns=host --cgroup-parent=pw-tmux.slice \
  $PW_TMUX_HOST_ALIAS_ARGS \
  -e TMUX_TMPDIR=/opt/project-workbench/run/tmux \
  -e PW_DEPLOY_MODE=container \
  -e PW_TMUX_OWNER_CGROUP=pw-tmux.slice \
  -e PW_TMUX_REQUIRE_CGROUP=1 \
  -e NPM_CONFIG_PREFIX=/opt/npm-global \
  -e PATH=/opt/npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
  -e "NODE_OPTIONS=--dns-result-order=ipv4first --no-network-family-autoselection" \
  -v /etc/server-docs:/etc/server-docs:ro \
  -v /opt/project-workbench/source/app:/opt/project-workbench/app \
  -v /opt/project-workbench/source/scripts:/opt/project-workbench/scripts \
  -v /opt/project-workbench/workspaces:/opt/project-workbench/workspaces \
  -v /opt/project-workbench/memory:/opt/project-workbench/memory \
  -v /etc/project-workbench:/etc/project-workbench \
  -v /etc/nginx/conf.d:/etc/nginx/conf.d \
  -v /opt/project-workbench/persistent/npm-global:/opt/npm-global \
  -v /opt/project-workbench/persistent/root-home:/root \
  -v /opt/project-workbench/persistent/admin-home:/home/admin \
  -v /opt/project-workbench/run/tmux:/opt/project-workbench/run/tmux \
  project-workbench:latest \
  /opt/project-workbench/scripts/pw-tmux-keepalive.sh
ExecStop=/usr/bin/podman stop -t 10 pw-tmux

[Install]
WantedBy=multi-user.target
