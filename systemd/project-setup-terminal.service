[Unit]
Description=ttyd setup/auth terminal for Project Workbench Setup Wizard
After=network-online.target
Wants=network-online.target
[Service]
# The one non-secret environment contract (app/env-schema.js), so the dashboard,
# terminal creation and restore cannot disagree about where this instance keeps
# its state. `-` prefix: absent is not fatal, because every entry has a
# documented default — a MISCONFIGURED entry is what must fail, and the consumer
# is what detects that.
EnvironmentFile=-/etc/project-workbench/pw.env
Type=simple
User=admin
Group=admin
Environment=HOME=/home/admin
ExecStart=/usr/local/bin/setup-terminal-start
Restart=on-failure
RestartSec=3
# This unit shares the default tmux socket with project-terminal@, so it can
# equally end up parenting the shared server. Same rationale as that unit:
# never let an OOM-killed pane or a ttyd restart reap the server behind it.
OOMPolicy=continue
KillMode=process
[Install]
WantedBy=multi-user.target
