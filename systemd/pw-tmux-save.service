[Unit]
Description=Project Workbench: snapshot tmux sessions for reboot persistence

[Service]
Type=oneshot
User=admin
Group=admin
Environment=HOME=/home/admin
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
ExecStart=/usr/local/bin/pw-tmux-save
# The authoritative non-secret environment contract (config/pw.env.example, app/pw-env.js).
# One file, read by the dashboard, both terminal units, the persistence units and the tmux owner, so
# no entrypoint can resolve a different registry/app dir/state dir/per-user flag than the others.
# `-` because a host that has not yet run the new installer must still start: the CONSUMERS enforce
# the contract (pw-tmux-restore exits EX_CONFIG on a misconfigured authoritative path), not systemd.
EnvironmentFile=-/etc/project-workbench/pw.env
