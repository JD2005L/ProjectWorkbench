[Unit]
Description=Contained deployment engine and administration console
Requires=podman.socket
After=podman.socket

[Container]
Image=sha256:REPLACE_WITH_REVIEWED_IMAGE_ID
ContainerName=pw-deploy
PublishPort=127.0.0.1:3800:3800
Volume=pw-deploy-state:/var/lib/pw-deploy
Volume=%t/podman/podman.sock:/run/pw-deploy/podman.sock:ro
Secret=pw-deploy-config,type=mount,target=/etc/pw-deploy/config.json,uid=0,gid=0,mode=0400
Secret=pw-deploy-api,type=mount,target=/run/secrets/pw-deploy-api,uid=0,gid=0,mode=0400
Secret=pw-deploy-ui,type=mount,target=/run/secrets/pw-deploy-ui,uid=0,gid=0,mode=0400
Secret=pw-deploy-runtime-key,type=mount,target=/run/secrets/pw-deploy-runtime-key,uid=0,gid=0,mode=0400
Secret=pw-deploy-known-hosts,type=mount,target=/etc/pw-deploy/known_hosts,uid=0,gid=0,mode=0400
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
User=0
Group=0
Tmpfs=/tmp:rw,nosuid,nodev,size=512m
Label=io.pw-deploy.controller=true

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=90

[Install]
WantedBy=default.target
