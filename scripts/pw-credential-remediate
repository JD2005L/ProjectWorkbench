#!/usr/bin/env node
// Find, and optionally repair, credential artifacts the old root-write path left behind.
//
// Fixing the write path stops new bad artifacts; it does nothing about the ones already on disk.
// GOA has at least one live: a root-owned `0600` `.pw-credentials` inside a `.git` owned by the
// pane account — unreadable by the account whose credential it is, so git authentication silently
// fails there, and a boundary violation besides.
//
//   pw-credential-remediate                 # report only; changes nothing
//   pw-credential-remediate --apply         # repair what needs repairing
//   pw-credential-remediate --apply --project NAME     # one project
//
// Repair is REPLACE-AS-THE-OWNER, never chown: the work runs through the same privilege-dropped,
// shell-free helper the dashboard uses, unlinks the bad artifact (permitted because the account owns
// the containing directory, whoever owns the file) and rewrites it atomically. Where the project's
// current token cannot be resolved the artifact is removed and the helper configuration cleared,
// because a credential nobody can read is worth less than no credential.
//
// It never follows a symlink, never recurses, and never touches a workspace whose `.git` is not
// owned by the expected account — those are reported for a human instead. Only projects listed in
// the registry are examined; nothing is globbed off the filesystem.
//
// Reports carry paths, ownership and modes. Never contents.
import fs from 'node:fs';
import path from 'node:path';
import { spawn } from 'node:child_process';
import { fileURLToPath } from 'node:url';

const APP_DIR = process.env.PW_APP_DIR || path.join(path.dirname(fileURLToPath(import.meta.url)), '..', 'app');
const { resolveTerminalOwner, makePasswdLookup } = await import(path.join(APP_DIR, 'terminal-owner.js'));
const { credentialDropArgv } = await import(path.join(APP_DIR, 'user-credentials.js'));
const { inventoryCredentialArtifacts, remediateCredentialArtifact } = await import(path.join(APP_DIR, 'credential-remediation.mjs'));

const argv = process.argv.slice(2);
const apply = argv.includes('--apply');
const only = argv.includes('--project') ? argv[argv.indexOf('--project') + 1] : '';
if (argv.includes('-h') || argv.includes('--help')) {
  process.stdout.write('usage: pw-credential-remediate [--apply] [--project NAME]\n');
  process.exit(0);
}

const registryPath = process.env.PW_REGISTRY_PATH || '/opt/project-workbench/projects.json';
let projects = [];
try {
  projects = JSON.parse(fs.readFileSync(registryPath, 'utf8'));
} catch (e) {
  process.stderr.write(`[remediate] cannot read the registry at ${registryPath}: ${e.code || e.message}\n`);
  process.exit(78);
}
const targets = projects.filter((p) => p?.path && (!only || p.name === only));
if (!targets.length) {
  process.stdout.write(`no matching projects in ${registryPath}\n`);
  process.exit(0);
}

const { execFile } = await import('node:child_process');
const { promisify } = await import('node:util');
const execFileAsync = promisify(execFile);
const owner = await resolveTerminalOwner(process.env, makePasswdLookup({ execFile: execFileAsync, readFile: (await import('node:fs/promises')).readFile }))
  .catch((e) => { process.stderr.write(`[remediate] cannot resolve the workspace owner: ${e.message}\n`); process.exit(78); });

/** Run one job through the privilege-drop boundary, exactly as the dashboard does. */
function runDropped(job) {
  const helper = path.join(APP_DIR, 'credential-writer.mjs');
  const args = credentialDropArgv({ owner, execPath: process.execPath, helperPath: helper });
  return new Promise((resolve, reject) => {
    const child = spawn(args[0], args.slice(1), { stdio: ['pipe', 'pipe', 'pipe'] });
    let out = ''; let err = '';
    child.stdout.on('data', (d) => { out += d; });
    child.stderr.on('data', (d) => { err += d; });
    child.on('error', reject);
    child.on('close', (code) => {
      let parsed = null;
      try { parsed = JSON.parse(out); } catch { /* helper died before writing */ }
      if (code === 0 && parsed?.ok) return resolve(parsed.result);
      reject(new Error(parsed?.error || err.trim().split('\n').pop() || `helper exited ${code}`));
    });
    child.stdin.end(JSON.stringify(job));
  });
}

const expectUid = owner ? owner.uid : (process.getuid?.() ?? undefined);
const paths = targets.map((p) => p.path);
const report = owner
  ? await runDropped({ action: 'git-credentials-inventory', projectPaths: paths, expectUid })
  : await inventoryCredentialArtifacts({ projectPaths: paths, expectUid });

const needing = report.findings.filter((f) => f.status !== 'ok');
process.stdout.write(`scanned ${report.scanned} project(s); ${needing.length} need attention\n`);
for (const f of report.findings) {
  if (f.status === 'ok') continue;
  const detail = f.reasons?.length ? ` — ${f.reasons.join('; ')}` : (f.reason ? ` — ${f.reason}` : '');
  process.stdout.write(`  ${f.status.padEnd(18)} ${f.projectPath}${detail}\n`);
}
if (!apply) {
  if (needing.length) process.stdout.write('\nre-run with --apply to repair (replace as the workspace owner; nothing is chowned)\n');
  process.exit(0);
}

let failed = 0;
for (const f of needing) {
  const project = targets.find((p) => p.path === f.projectPath);
  // The current token is not resolved here: this tool has no access to the secret key, by design.
  // Removing the artifact and clearing the helper is the safe repair; the dashboard rewrites a
  // correct one on the next credential sync for that project.
  const job = { action: 'git-credentials-remediate', projectPath: f.projectPath, expectUid, ghToken: '' };
  try {
    const res = owner ? await runDropped(job) : await remediateCredentialArtifact({ ...job, token: '' });
    process.stdout.write(`  ${String(res.action).padEnd(18)} ${project?.name || f.projectPath}\n`);
    if (res.action === 'failed') failed++;
  } catch (e) {
    failed++;
    process.stderr.write(`  failed             ${project?.name || f.projectPath}: ${e.message}\n`);
  }
}
process.stdout.write(failed ? `\n${failed} project(s) could not be repaired\n` : '\nrepair complete\n');
process.exit(failed ? 1 : 0);
