#!/usr/bin/env bash
set -euo pipefail
name="$1"
# PW_REGISTRY_PATH override matches app/isolation.js's own env var (same
# file, same name) so this script and the dashboard can never disagree about
# which registry is authoritative; unset falls back to the canonical path.
json="${PW_REGISTRY_PATH:-/opt/project-workbench/projects.json}"
[[ -f "$json" ]] || { echo "[project-terminal-start] $json not found" >&2; exit 1; }
path=$(jq -r --arg n "$name" '.[] | select(.name==$n) | .path // empty' "$json")
port=$(jq -r --arg n "$name" '.[] | select(.name==$n) | .port // empty' "$json")
repo=$(jq -r --arg n "$name" '.[] | select(.name==$n) | .repo // empty' "$json")
primary_user=$(jq -r --arg n "$name" '.[] | select(.name==$n) | .primaryUser // empty' "$json")
[[ -n "$path" ]] || { echo "[project-terminal-start] no .path in projects.json for '$name'" >&2; exit 1; }
[[ -n "$port" ]] || { echo "[project-terminal-start] no .port in projects.json for '$name'" >&2; exit 1; }
# Isolates every tmux call onto a private socket for tests (see
# test/project-terminal-start.test.mjs); unset (the default, always true in
# production) means the normal per-user default socket, byte-identical to
# before this variable existed. Mirrors app/server.js's own PW_TMUX_SOCKET.
tmux_sock_args=()
[[ -n "${PW_TMUX_SOCKET:-}" ]] && tmux_sock_args=(-L "$PW_TMUX_SOCKET")
mkdir -p "$path"
real_path=$(readlink -f "$path")
chown -R admin:admin "$real_path" 2>/dev/null || true
cd "$real_path"
if [[ -d .git ]]; then
  git config --global --add safe.directory "$real_path" 2>/dev/null || true
elif [[ -n "$repo" && "$repo" != null ]]; then
  echo "Workspace not cloned yet. Run: git clone $repo ."
fi
claude_path=$(command -v claude || true)
[[ -n "$claude_path" ]] || claude_path="missing"
# ProjectWorkbench terminals are created only for managed local workspaces.
# Pre-mark them trusted so CRUD-created projects open Claude Code immediately.
python3 - "$real_path" <<'PY' 2>/dev/null || true
import json, os, sys, time
path=sys.argv[1]
conf=os.path.expanduser('~/.claude.json')
try:
    with open(conf) as f: data=json.load(f)
except Exception:
    data={}
projects=data.setdefault('projects', {})
entry=projects.setdefault(path, {})
entry.setdefault('allowedTools', [])
entry.setdefault('mcpContextUris', [])
entry.setdefault('mcpServers', {})
entry.setdefault('enabledMcpjsonServers', [])
entry.setdefault('disabledMcpjsonServers', [])
entry['hasTrustDialogAccepted']=True
entry.setdefault('projectOnboardingSeenCount', 0)
entry.setdefault('hasClaudeMdExternalIncludesApproved', False)
entry.setdefault('hasClaudeMdExternalIncludesWarningShown', False)
entry.setdefault('hasCompletedProjectOnboarding', True)
entry.setdefault('lastGracefulShutdown', True)
tmp=conf+'.tmp'
with open(tmp,'w') as f: json.dump(data,f,indent=2)
os.replace(tmp, conf)
PY
session="pw_${name//[^A-Za-z0-9_]/_}"
already_exists=0
tmux "${tmux_sock_args[@]}" has-session -t "$session" 2>/dev/null && already_exists=1

# Unified existing-session policy (mirrors app/server.js's ensureTmuxSession):
# the tmux session may keep running either way — this script never kills one
# — but ATTACHING to (or creating) one always resolves the CURRENT owner via
# app/project-terminal-credentials.mjs (the same fail-closed contract as
# app/server.js's credentialContext()) and, for an ALREADY-EXISTING session,
# requires its stamped fingerprint to match that current owner exactly. A
# resolution failure (unreadable users store, a primaryUser that doesn't
# resolve, an undecryptable token, a failing credential helper) OR a stamped
# fingerprint that does not match the current owner (the owner rotated a
# token, was renamed, or was reassigned) both refuse to attach — continuity
# of an already-open terminal is not a reason to hand it off under an
# unverified or stale identity. Only on an exact match (or the legitimate
# "never stamped, and currently shared/no-owner" case) does this proceed.
node_bin=$(command -v node || echo /usr/bin/node)
app_dir="${PW_APP_DIR:-/opt/project-workbench/app}"
if ! cred_json=$("$node_bin" "$app_dir/project-terminal-credentials.mjs" "$name" "$primary_user"); then
  cred_err=$(printf '%s' "$cred_json" | jq -r '.error // empty' 2>/dev/null || true)
  echo "[project-terminal-start] per-user credential resolution failed for '$name' (owner '$primary_user'): ${cred_err:-$cred_json}" >&2
  exit 1
fi
cred_config_dir=$(printf '%s' "$cred_json" | jq -r '.configDir // empty')
cred_env_file=$(printf '%s' "$cred_json" | jq -r '.envFile // empty')
cred_key=$(printf '%s' "$cred_json" | jq -r '.fingerprint // empty')
[[ -z "$cred_key" ]] && cred_key="off"   # matches app/user-credentials.js's CREDENTIALS_OFF sentinel

base_tab_env="env HOME=/home/admin LANG=C.UTF-8 LC_ALL=C.UTF-8 TERM=screen-256color COLORTERM=truecolor PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin"
if [[ -n "$cred_config_dir" ]]; then
  printf -v quoted_cfg '%q' "CLAUDE_CONFIG_DIR=$cred_config_dir"
  if [[ -n "$cred_env_file" ]]; then
    printf -v quoted_rcfile '%q' "$cred_env_file"
    tab_env="$base_tab_env $quoted_cfg bash --noprofile --rcfile $quoted_rcfile"
  else
    tab_env="$base_tab_env $quoted_cfg bash --noprofile --norc"
  fi
else
  tab_env="$base_tab_env bash --noprofile --norc"
fi

# Reads the session's stamped credential fingerprint, distinguishing a
# genuinely-unset option (tmux's own "invalid option" error, surfaced by NOT
# passing -q — which instead makes tmux swallow every kind of failure into
# the same empty-stdout/exit-0 result) from any other tmux failure (session
# vanished, socket error, corrupt server). Mirrors app/server.js's
# readSessionCredKey exactly. Sets cred_key_read_ok (1/0) and cred_key_read;
# callers must fail closed on cred_key_read_ok=0, never coerce it into
# "unstamped" — that ambiguity is exactly the gap this closes.
read_cred_key() {
  local sess="$1" errfile rc
  errfile=$(mktemp)
  cred_key_read=$(tmux "${tmux_sock_args[@]}" show-options -t "$sess" -v @pw_cred_key 2>"$errfile")
  rc=$?
  cred_key_read_err=$(cat "$errfile")
  rm -f "$errfile"
  if [[ $rc -eq 0 ]]; then
    cred_key_read_ok=1
    return 0
  fi
  if [[ "$cred_key_read_err" == *"invalid option"* ]]; then
    cred_key_read_ok=1
    cred_key_read=""
    return 0
  fi
  cred_key_read_ok=0
  cred_key_read=""
  return 1
}
# Stamps the fingerprint AND reads it back to confirm the write actually
# landed — a set-option that exits nonzero, or one a control-plane hiccup
# silently drops, must not be trusted without checking. Mirrors
# app/server.js's stampSessionCredKey.
stamp_cred_key() {
  local sess="$1" key="$2" errfile rc seterr
  errfile=$(mktemp)
  tmux "${tmux_sock_args[@]}" set-option -t "$sess" @pw_cred_key "$key" 2>"$errfile"
  rc=$?
  seterr=$(cat "$errfile"); rm -f "$errfile"
  if [[ $rc -ne 0 ]]; then
    echo "[project-terminal-start] failed to stamp credential fingerprint on session '$sess': $seterr" >&2
    return 1
  fi
  if ! read_cred_key "$sess" || [[ "$cred_key_read" != "$key" ]]; then
    echo "[project-terminal-start] could not verify credential fingerprint stamp on session '$sess' (wrote '$key', read back '${cred_key_read}', ok=${cred_key_read_ok:-0})" >&2
    return 1
  fi
  return 0
}

if [[ "$already_exists" -eq 1 ]]; then
  if ! read_cred_key "$session"; then
    echo "[project-terminal-start] project '$name' has an unverifiable credential fingerprint ($cred_key_read_err) — refusing to attach a possibly-mismatched identity. Recycle required: POST /api/term/$name/recycle" >&2
    exit 1
  fi
  stamped_key="$cred_key_read"
  if [[ -n "$stamped_key" ]]; then
    if [[ "$stamped_key" != "$cred_key" ]]; then
      echo "[project-terminal-start] project '$name' has a stale credential fingerprint (session stamped '$stamped_key', current owner resolves to '$cred_key') — refusing to attach a possibly-mismatched identity. Recycle required: POST /api/term/$name/recycle" >&2
      exit 1
    fi
  elif [[ "$cred_key" != "off" ]]; then
    echo "[project-terminal-start] project '$name' has an unstamped session but a real per-user owner is now expected ('$cred_key') — refusing to attach an unverifiable identity. Recycle required: POST /api/term/$name/recycle" >&2
    exit 1
  else
    # Legitimately never stamped AND currently shared/no-owner: nothing to be
    # stale about — adopt the stamp now (upgrade hygiene), same as
    # app/server.js's ensureTmuxSession.
    if ! stamp_cred_key "$session" "$cred_key"; then
      echo "[project-terminal-start] project '$name': refusing to attach — could not verify the credential fingerprint stamp" >&2
      exit 1
    fi
  fi
else
  tmux "${tmux_sock_args[@]}" -u new-session -d -s "$session" -c "$real_path" "$tab_env"
  # Stamp the same non-secret fingerprint app/server.js stamps on sessions it
  # creates (@pw_cred_key), so GET /api/projects/status's staleness check
  # (credentialsStale) treats a session started here identically to one
  # started via the dashboard — see app/user-credentials.js. A session whose
  # stamp cannot be verified must not be handed off as though creation
  # succeeded (the session itself is left running, same never-kill policy as
  # everywhere else in this script — just not attached to/exec'd into ttyd).
  if ! stamp_cred_key "$session" "$cred_key"; then
    echo "[project-terminal-start] project '$name': refusing to hand off a freshly created session — could not verify the credential fingerprint stamp" >&2
    exit 1
  fi
  tmux "${tmux_sock_args[@]}" send-keys -t "$session" "printf 'Project workspace: %s\nClaude: %s\nPersistent console: tmux session %s\nTip: run claude from here after auth is completed.\n\n' '$real_path' '$claude_path' '$session'" C-m
  # Auto-spawn tab templates flagged autoStart. The cmd is typed into the
  # new window via send-keys so the shell stays alive after it exits.
  while IFS=$'\t' read -r tab_name tab_cmd; do
    [[ -z "$tab_name" ]] && continue
    tmux "${tmux_sock_args[@]}" new-window -t "$session" -c "$real_path" -n "$tab_name" "$tab_env" || continue
    if [[ -n "$tab_cmd" ]]; then
      tmux "${tmux_sock_args[@]}" send-keys -t "$session:$tab_name" "$tab_cmd" C-m
    fi
  done < <(jq -r --arg n "$name" '.[] | select(.name==$n) | .tabs // [] | .[] | select(.autoStart==true) | "\(.name)\t\(.cmd // "")"' "$json")
  tmux "${tmux_sock_args[@]}" select-window -t "$session:0" 2>/dev/null || true
fi
exec /usr/bin/ttyd \
  --interface 127.0.0.1 \
  --port "$port" \
  --base-path "/pty/$name" \
  --writable \
  --terminal-type xterm-256color \
  --client-option fontFamily=monospace \
  --client-option fontSize=14 \
  --client-option lineHeight=1 \
  --client-option letterSpacing=0 \
  --client-option disableLeaveAlert=true \
  --check-origin \
  tmux "${tmux_sock_args[@]}" -u new-session -A -s "$session" -c "$real_path" "$tab_env"
