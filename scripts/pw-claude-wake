#!/bin/bash
# Project Workbench: tmux hook target that wakes a hibernated Claude Code window when someone opens it.
#
# `pw-claude-hibernate --install-hooks` appends this to client-attached, client-session-changed,
# session-window-changed and pane-focus-in as
#     run-shell -b "pw-claude-wake '#{socket_path}' '#{window_id}'"
# It does nothing unless every one of these holds: the window carries hibernation markers that name it;
# its placeholder (pw-claude-wait) is waiting; the window is its session's current window; and a client is
# attached to that session, i.e. a person is actually looking at it. Then it presses Enter in the window,
# which resumes the conversation in place.
set -u

sock="${1:-}"
wid="${2:-}"
[[ "$wid" =~ ^@[0-9]+$ ]] || exit 0

t() {
	if [[ -n "$sock" ]]; then timeout 5 tmux -S "$sock" "$@"; else timeout 5 tmux "$@"; fi
}

sid=$(t show-options -wqv -t "$wid" @pw_claude_sid 2>/dev/null) || exit 0
named=$(t show-options -wqv -t "$wid" @pw_claude_hib_win 2>/dev/null) || exit 0
[[ -n "$sid" && "$named" == "$wid" ]] || exit 0

waiting=$(t show-options -wqv -t "$wid" @pw_claude_waiting 2>/dev/null) || exit 0
[[ "$waiting" =~ ^[0-9]+$ && -r "/proc/$waiting/cmdline" ]] || exit 0
tr '\0' ' ' <"/proc/$waiting/cmdline" | grep -q 'pw-claude-wait' || exit 0

read -r attached active pane < <(t display-message -p -t "$wid" '#{session_attached} #{window_active} #{pane_id}' 2>/dev/null) || exit 0
[[ "$attached" =~ ^[0-9]+$ ]] && (( attached > 0 )) && [[ "$active" == "1" && "$pane" =~ ^%[0-9]+$ ]] || exit 0

# Several hooks fire for one visit (attach, session and window change, focus), each in its own run-shell.
# Checking the claim and pressing Enter in ONE tmux command makes them atomic: the server runs a client's
# command list without interleaving another client's, so only the first wake still finds its pid there.
# (Reading it separately first let three wakes all press Enter; the resumed Claude got the extra newlines.)
t if-shell -F -t "$wid" "#{==:#{@pw_claude_waiting},$waiting}" \
    "set-option -wu -t $wid @pw_claude_waiting ; send-keys -t $pane Enter"
