#!/usr/bin/env bash
set -euo pipefail
LOG=/var/log/claude-code-update.log
WORKBENCH_JSON=/etc/project-workbench/workbench.json

cli_pkg() {
  case "$1" in
    claude)  echo "@anthropic-ai/claude-code" ;;
    codex)   echo "@openai/codex" ;;
    copilot) echo "@github/copilot" ;;
    *)       echo "" ;;
  esac
}

install_claude_wrapper() {
  # Keep npm-managed /bin/claude and /usr/bin/claude symlinks untouched.
  # Put a stable local wrapper earlier in PATH. Blanket permissions and shared memory are common
  # to PW instances; MCP behavior is instance-local via /etc/project-workbench/claude-wrapper.env.
  rm -f /usr/local/bin/claude
  cat > /usr/local/bin/claude <<'BASH'
#!/usr/bin/env bash
set -euo pipefail
NPM_ROOT="$(npm root -g 2>/dev/null || true)"
REAL="${NPM_ROOT}/@anthropic-ai/claude-code/cli-wrapper.cjs"
if [[ ! -f "$REAL" && -f /usr/lib/node_modules/@anthropic-ai/claude-code/cli-wrapper.cjs ]]; then
  REAL=/usr/lib/node_modules/@anthropic-ai/claude-code/cli-wrapper.cjs
fi
if [[ ! -f "$REAL" && -f /usr/local/lib/node_modules/@anthropic-ai/claude-code/cli-wrapper.cjs ]]; then
  REAL=/usr/local/lib/node_modules/@anthropic-ai/claude-code/cli-wrapper.cjs
fi
if [[ ! -f "$REAL" && -x /usr/lib/node_modules/@anthropic-ai/claude-code/bin/claude.exe ]]; then
  REAL=/usr/lib/node_modules/@anthropic-ai/claude-code/bin/claude.exe
fi
CONFIG=/etc/project-workbench/claude-wrapper.env

PW_SHARED_MEMORY=/opt/project-workbench/memory
PW_MCP_MODE=inherit
PW_MCP_CONFIG=/etc/project-workbench/empty-mcp.json
PW_PERMISSION_MODE=prompt
PW_REMOTE_CONTROL=true
if [[ -f "$CONFIG" ]]; then
  # shellcheck source=/etc/project-workbench/claude-wrapper.env
  source "$CONFIG"
fi

args=()
has_permission=0
has_add_dir=0
has_mcp_config=0
has_remote_control=0
has_print=0
for arg in "$@"; do
  case "$arg" in
    --permission-mode|--permission-mode=*|--dangerously-skip-permissions|--allow-dangerously-skip-permissions)
      has_permission=1
      ;;
    --add-dir|--add-dir=*)
      has_add_dir=1
      ;;
    --mcp-config|--mcp-config=*|--strict-mcp-config)
      has_mcp_config=1
      ;;
    --remote-control|--remote-control=*|--remote-control-session-name-prefix|--remote-control-session-name-prefix=*)
      has_remote_control=1
      ;;
    -p|--print)
      has_print=1
      ;;
  esac
done

if [[ "$has_permission" -eq 0 && "${PW_PERMISSION_MODE:-prompt}" == "skip" ]]; then
  args+=(--dangerously-skip-permissions)
fi
if [[ "$has_add_dir" -eq 0 && -n "${PW_SHARED_MEMORY:-}" && -d "$PW_SHARED_MEMORY" ]]; then
  args+=(--add-dir "$PW_SHARED_MEMORY")
fi
# Remote-control is an interactive-only feature; skip for --print runs so we
# don't break non-interactive pipes.
if [[ "$has_remote_control" -eq 0 && "$has_print" -eq 0 && "${PW_REMOTE_CONTROL:-true}" == "true" ]]; then
  args+=(--remote-control)
fi
if [[ "$has_mcp_config" -eq 0 ]]; then
  case "${PW_MCP_MODE:-inherit}" in
    inherit)
      ;;
    isolated)
      if [[ -f "$PW_MCP_CONFIG" ]]; then
        args+=(--mcp-config "$PW_MCP_CONFIG" --strict-mcp-config)
      fi
      ;;
    custom)
      if [[ -f "$PW_MCP_CONFIG" ]]; then
        args+=(--mcp-config "$PW_MCP_CONFIG" --strict-mcp-config)
      else
        echo "PW_MCP_MODE=custom but PW_MCP_CONFIG not found: $PW_MCP_CONFIG" >&2
        exit 1
      fi
      ;;
    *)
      echo "Invalid PW_MCP_MODE: $PW_MCP_MODE (expected inherit, isolated, or custom)" >&2
      exit 1
      ;;
  esac
fi

case "$REAL" in
  *.cjs) exec /usr/bin/node "$REAL" "${args[@]}" "$@" ;;
  *)     exec "$REAL" "${args[@]}" "$@" ;;
esac
BASH
  chmod +x /usr/local/bin/claude
}

update_one() {
  local cli="$1"
  local pkg
  pkg="$(cli_pkg "$cli")"
  if [[ -z "$pkg" ]]; then
    echo "Unknown CLI: $cli" >&2
    return 1
  fi
  echo "----- $(date -Is) updating $cli ($pkg) -----"
  if [[ "$cli" == "claude" ]]; then
    echo "Before: $(/usr/local/bin/claude --version 2>/dev/null || echo missing)"
  else
    echo "Before: $(command -v "$cli" >/dev/null && "$cli" --version 2>/dev/null || echo missing)"
  fi
  npm install -g "$pkg@latest"
  if [[ "$cli" == "claude" ]]; then
    # Only refresh the wrapper on an instance that already launches claude through
    # one. Updating a CLI must not change HOW it is launched, and
    # install_claude_wrapper() is an rm -f plus a rewrite: on an instance that
    # deliberately runs the npm binary directly (/usr/local/bin/claude being a
    # symlink to it), an unconditional refresh newly imposes whatever
    # claude-wrapper.env happens to say — which in practice has meant
    # --dangerously-skip-permissions and an --mcp-config override that displaces
    # user-scope MCP servers. Nobody enabling nightly updates is asking for that.
    if [[ -f /usr/local/bin/claude ]] && [[ "$(head -c2 /usr/local/bin/claude 2>/dev/null)" == '#!' ]]; then
      install_claude_wrapper
    else
      echo "Wrapper refresh skipped: /usr/local/bin/claude is not a PW wrapper — launch path left as-is"
    fi
    echo "After:  $(/usr/local/bin/claude --version 2>/dev/null || echo missing)"
  else
    echo "After:  $(command -v "$cli" >/dev/null && "$cli" --version 2>/dev/null || echo missing)"
  fi
}

# Record when each CLI was last checked, somewhere the dashboard can actually read.
#
# The only previous signal was this script's own log mtime, and the dashboard reads
# it from inside a container that does not mount /var/log — so the field was
# structurally always "never" on a container install, however often the timer ran.
# /etc/project-workbench IS bind-mounted 1:1 into the containers, so a stamp
# written there is visible by construction.
#
# Tab-separated rather than JSON so this needs no jq to write (jq is only a
# best-effort dependency above) and no escaping of anything.
STAMPS=/etc/project-workbench/cli-updates.tsv
stamp_cli() {
  local cli="$1" status="$2" tmp
  tmp="$(mktemp "${STAMPS}.XXXXXX" 2>/dev/null)" || return 0
  {
    [[ -f "$STAMPS" ]] && awk -F'\t' -v c="$cli" '$1 != c' "$STAMPS"
    printf '%s\t%s\t%s\n' "$cli" "$(date -Is)" "$status"
  } > "$tmp" 2>/dev/null
  if chmod 0644 "$tmp" 2>/dev/null && mv -f "$tmp" "$STAMPS" 2>/dev/null; then
    return 0
  fi
  rm -f "$tmp" 2>/dev/null
  return 0
}

read_update_clis() {
  if [[ -f "$WORKBENCH_JSON" ]] && command -v jq >/dev/null; then
    jq -r '(.updateClis // ["claude"]) | .[]' "$WORKBENCH_JSON"
  else
    echo claude
  fi
}

{
  echo "===== $(date -Is) PW CLI update start ====="
  mapfile -t CLIS < <(read_update_clis)
  if [[ ${#CLIS[@]} -eq 0 ]]; then
    echo "No CLIs configured in $WORKBENCH_JSON; defaulting to claude"
    CLIS=(claude)
  fi
  for cli in "${CLIS[@]}"; do
    # Stamp the attempt either way: "checked and failed" is information the
    # operator needs, and a missing stamp would read as "never checked".
    if update_one "$cli"; then
      stamp_cli "$cli" ok
    else
      echo "Failed to update $cli"
      stamp_cli "$cli" failed
    fi
  done
  systemctl restart project-workbench.service || true
  echo "===== $(date -Is) PW CLI update complete ====="
} >> "$LOG" 2>&1
